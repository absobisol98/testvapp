{
    "name": "riodwanto/superduper-filament-starter-kit",
    "description": "A Filament💡 starting point to kickstart your next app. With Custom Theme, Mail Configuration, Filament Shield, Filament Exception, etc..",
    "type": "project",
    "keywords": [
        "filament",
        "filamentphp",
        "laravel",
        "filament starter kit",
        "starter kit",
        "superduper",
        "website"
    ],
    "authors": [
        {
            "name": "Rio Dewanto P",
            "email": "riodp.tech@gmail.com"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-snappy": "^1.0",
        "bezhansalleh/filament-exceptions": "^2.1",
        "bezhansalleh/filament-shield": "^3.2",
        "blade-ui-kit/blade-heroicons": "^2.6",
        "claviska/simpleimage": "^4.2",
        "codeat3/blade-fluentui-system-icons": "^1.32",
        "datlechin/filament-menu-builder": "^0.5.2",
        "diogogpinto/filament-auth-ui-enhancer": "^1.0",
        "dotswan/filament-map-picker": "^1.7",
        "endroid/qr-code": "^6.0",
        "filament/filament": "^3.2",
        "filament/spatie-laravel-media-library-plugin": "^3.2",
        "filament/spatie-laravel-settings-plugin": "^3.2",
        "filament/spatie-laravel-tags-plugin": "^3.2",
        "flowframe/laravel-trend": "^0.3.0",
        "guzzlehttp/guzzle": "^7.2",
        "h4cc/wkhtmltoimage-amd64": "0.12.x",
        "h4cc/wkhtmltopdf-amd64": "0.12.x",
        "jeffgreco13/filament-breezy": "^2.2",
        "josespinal/filament-record-navigation": "^2.0",
        "khanamiryan/qrcode-detector-decoder": "^2.0",
        "laravel/framework": "^11.9",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.8",
        "league/commonmark": "^2.4",
        "leandrocfe/filament-apex-charts": "^3.1",
        "maatwebsite/excel": "^3.1",
        "matt-daneshvar/laravel-survey": "^0.4.0",
        "opcodesio/log-viewer": "^3.11",
        "owenvoke/blade-fontawesome": "^2.6",
        "riodwanto/filament-ace-editor": "^1.0",
        "saade/filament-fullcalendar": "^3.2",
        "spatie/icalendar-generator": "^2.9",
        "stichoza/google-translate-php": "^5.2",
        "tapp/filament-form-builder": "^1.31",
        "tapp/filament-google-autocomplete-field": "^1.0",
        "tapp/filament-maillog": "^1.0",
        "tomatophp/filament-media-manager": "^1.1",
        "visualbuilder/email-templates": "^3.1",
        "wemersonjanuario/wkhtmltopdf-windows": "0.12.2.3",
        "ysfkaya/filament-phone-input": "^3.1",
        "z3d0x/filament-logger": "^0.7.2"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/TappNetwork/Filament-Form-Builder"
        }
    ],

    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.14",
        "fakerphp/faker": "^1.9.1",
        "kitloong/laravel-migrations-generator": "^7.0",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^10.1",
        "reliese/laravel": "^1.3",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
